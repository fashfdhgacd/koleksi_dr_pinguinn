# Salin ke .env.local / set di Vercel + Cloudflare Environment Variables.
# Jangan commit file .env asli.

# Streamtape thumbnail (opsional — tanpa ini thumb pakai placeholder)
STREAMTAPE_LOGIN=
STREAMTAPE_KEY=
# STREAMTAPE_API=https://api.streamtape.com

# Merge feed remote ke katalog (opsional, default mati)
# CATALOG_REMOTE=1

# Panel pemilik /pemilik — wajib
# openssl rand -hex 24
ONLINE_VIEW_SECRET=

# Alert Telegram saat online >= N (opsional)
# ONLINE_ALERT_THRESHOLD=20
# ONLINE_ALERT_CHAT_ID=  (atau TELEGRAM_USER_ID / TELEGRAM_ADMIN_ID)
# BOT_TOKEN= / TELEGRAM_BOT_TOKEN=

# Bot Telegram (opsional, jangan dijalankan sebagai serverless Vercel)
# BOT_TOKEN=
# TELEGRAM_BOT_TOKEN=

# Bot commit ke GitHub (opsional)
# GITHUB_TOKEN=
# GITHUB_OWNER=fashfdhgacd
# GITHUB_REPO=koleksi_dr_pinguinn
# GH_TOKEN=
# GH_OWNER=
# GH_REPO=

# Auth / database (tidak dipakai mode katalog mandiri)
# DATABASE_URL=
# VITE_AUTH_ENABLED=false
